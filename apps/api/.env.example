APP_ENV=development
DATABASE_URL=sqlite:///./data/lablink.db
STORAGE_DIR=./data/uploads
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
SESSION_HOURS=24
SEED_DEMO=true
# Deterministic local retrieval works without an API key.
AI_MODE=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Optional import whitelist: comma-separated public HTTPS academic hosts.
CRAWL_ALLOWED_HOSTS=
