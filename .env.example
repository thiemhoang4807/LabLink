# Docker Compose local demo only. Copy to .env; never commit the real .env.
POSTGRES_PASSWORD=lablink_local_demo_change_me

# local = deterministic lexical retrieval, no external AI calls
# openai = optional external embeddings/reranking after consent checks
AI_MODE=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4.1-mini
CRAWL_ALLOWED_HOSTS=uit.edu.vn
